# Public build-time values for production and Cloudflare preview builds.
# Committed on purpose: nothing here is secret, and keeping it in the repo
# means Cloudflare Workers Builds needs no build variables at all. A build
# variable with the same name in the Cloudflare dashboard would override
# these, so leave them unset there.

# Salesforce REST/Tooling API version used by browser scans
# (the code falls back to the same value when this is unset).
PUBLIC_SF_API_VERSION=66.0

# Fallback origin for redirect_uri outside a browser (build time, tests).
# In the browser the callback always uses the origin serving the page.
PUBLIC_APP_ORIGIN=https://quantumshield.opensf.foundation

# Never set in production: users bring their own Consumer Key, and the dev
# mock sign-in is hard-disabled in production builds anyway.
PUBLIC_SF_CLIENT_ID=
PUBLIC_DEV_MOCK=0
