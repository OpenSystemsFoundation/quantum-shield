{
  "name": "quantum-shield",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "bin": {
    "qshield": "./bin/qshield.mjs"
  },
  "scripts": {
    "sync:regulations": "node scripts/sync-regulations.mjs",
    "capture:scan-fixtures": "node scripts/capture-scan-fixtures.mjs --target-org quantum-shield",
    "design:lint": "node scripts/lint-design-md.mjs DESIGN.md",
    "predev": "npm run sync:regulations",
    "dev": "astro dev --host localhost --port 4321",
    "prebuild": "npm run sync:regulations",
    "build": "astro build",
    "prepreview": "npm run sync:regulations",
    "preview": "astro preview --host localhost --port 4321",
    "astro": "astro",
    "precheck": "npm run sync:regulations",
    "check": "astro check",
    "pretest": "npm run sync:regulations",
    "test": "vitest run",
    "pretest:watch": "npm run sync:regulations",
    "test:watch": "vitest",
    "pretest:e2e": "npm run sync:regulations",
    "test:e2e": "playwright test",
    "preqshield": "npm run sync:regulations",
    "qshield": "tsx cli/index.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/svelte": "^8.0.5",
    "astro": "^6.1.9",
    "comlink": "^4.4.2",
    "idb": "^8.0.3",
    "jsforce": "^3.10.14",
    "pdf-lib": "^1.17.1",
    "svelte": "^5.16.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@google/design.md": "^0.1.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "gray-matter": "^4.0.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  }
}
