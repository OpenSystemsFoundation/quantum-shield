<?xml version="1.0" encoding="UTF-8"?>
<SecuritySettings xmlns="http://soap.sforce.com/2006/04/metadata">
    <sessionSettings>
        <!-- Browser-mode token exchange is a cross-origin POST to
             /services/oauth2/token. Salesforce only returns CORS headers on
             the OAuth endpoints when this is on (Setup > CORS > "Enable CORS
             for OAuth endpoints"). -->
        <enableOauthCorsPolicy>true</enableOauthCorsPolicy>
    </sessionSettings>
</SecuritySettings>
