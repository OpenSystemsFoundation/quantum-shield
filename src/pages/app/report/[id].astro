---
import Shell from '../../../layouts/Shell.astro';
import ReportViewIsland from '../../../components/ReportView.svelte';

export const prerender = false;
const { id } = Astro.params;
const scanId = id ?? '';
if (!scanId) return Astro.redirect('/app');
---

<Shell title={`Report ${scanId} — QuantumShield`}>
  <ReportViewIsland client:only="svelte" scanId={scanId} />
</Shell>
