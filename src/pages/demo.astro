---
/**
 * Public sample report. Renders the report UI over the bundled fixtures in
 * clearly labelled sample mode — no sign-in, no session, nothing stored.
 */
import Shell from '../layouts/Shell.astro';
import ReportViewIsland from '../components/ReportView.svelte';
---

<Shell
  title="Sample report (demo data) — QuantumShield"
  description="A sample QuantumShield report built from bundled demo data, so you can see the findings view without connecting a Salesforce org."
>
  <ReportViewIsland demo client:only="svelte" />
  <noscript>
    <p style="padding:24px;">The sample report needs JavaScript. See the <a href="/docs/rules">rule catalog</a> instead.</p>
  </noscript>
</Shell>
