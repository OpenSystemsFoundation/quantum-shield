---
import Shell from '../layouts/Shell.astro';
import BlochShield from '../components/BlochShield.svelte';
---

<Shell title="Setup guide — QuantumShield">
  <div style="border-bottom:1px solid var(--line);background:var(--surface);">
    <div style="max-width:1200px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;">
      <a href="/" class="brand hstack" style="font-weight:600;color:var(--ink);">
        <BlochShield size={24} />
        <span>QuantumShield</span>
      </a>
      <a href="/connect" style="font-size:12.5px;color:var(--muted);">Back to connect →</a>
    </div>
  </div>

  <main style="max-width:820px;margin:0 auto;padding:48px 32px 80px;">
    <div class="tiny-caps" style="color:var(--navy-600);">Setup guide</div>
    <h1 class="serif" style="font-size:34px;font-weight:500;letter-spacing:-0.015em;margin:6px 0 10px;">
      Prepare your Salesforce org for QuantumShield
    </h1>
    <p style="font-size:14.5px;color:var(--ink-3);max-width:680px;">
      QuantumShield never creates anything in a Salesforce org we own. You create a small External Client App in your org, we guide you through it, and you can revoke access at any time from
      <span class="mono">Setup → App Manager</span>.
    </p>

    <section style="margin-top:40px;display:grid;gap:20px;">
      <article class="qs-card">
        <div class="qs-card-head"><h3>Part 1 · Create the External Client App</h3></div>
        <div class="qs-card-body">
          <ol class="cors-steps" style="list-style:none;padding:0;">
            <li class="cors-step">
              <div class="num">1</div>
              <div class="body">
                Open <span class="mono" style="color:var(--ink)">Setup → App Manager</span> and click <span class="mono" style="color:var(--ink)">New External Client App</span>. On orgs without External Client Apps yet, use <span class="mono" style="color:var(--ink)">New Connected App</span>.
              </div>
            </li>
            <li class="cors-step">
              <div class="num">2</div>
              <div class="body">Name: <span class="mono" style="color:var(--ink)">QuantumShield Scanner</span>. Contact email: your own.</div>
            </li>
            <li class="cors-step">
              <div class="num">3</div>
              <div class="body">
                Under API (Enable OAuth Settings): enable OAuth; enable <span class="mono" style="color:var(--ink)">Require PKCE</span>; leave Device Flow and Client Credentials off.
              </div>
            </li>
            <li class="cors-step">
              <div class="num">4</div>
              <div class="body">
                Scopes: <span class="mono" style="color:var(--ink)">api</span>, <span class="mono" style="color:var(--ink)">refresh_token</span>, <span class="mono" style="color:var(--ink)">id</span>. Do not select <span class="mono" style="color:var(--ink)">full</span> or <span class="mono" style="color:var(--ink)">web</span>.
              </div>
            </li>
            <li class="cors-step">
              <div class="num">5</div>
              <div class="body">Save. Wait 2–10 minutes for policy propagation.</div>
            </li>
          </ol>
        </div>
      </article>

      <article class="qs-card">
        <div class="qs-card-head"><h3>Part 2 · Whitelist our callback URL</h3></div>
        <div class="qs-card-body">
          <p class="sub" style="margin-top:0;">
            In the External Client App you just created, add this URL to the <span class="mono" style="color:var(--ink)">Callback URL</span> list:
          </p>
          <div class="cors-step" style="grid-template-columns:1fr;">
            <div class="body">
              <div class="mono-field">
                <code id="redirect-uri">https://quantumshield.example/callback</code>
                <button type="button" id="copy-callback">Copy</button>
              </div>
            </div>
          </div>
          <p style="margin-top:10px;font-size:11.5px;color:var(--muted);font-family:var(--mono);">
            You can add multiple callback URLs. After saving, the change is live immediately.
          </p>
        </div>
      </article>

      <article class="qs-card" id="cors">
        <div class="qs-card-head"><h3>Part 3 · Add QuantumShield to CORS</h3></div>
        <div class="qs-card-body">
          <div class="cors-panel">
            <div class="head">
              <div class="ico">!</div>
              <div>
                <h4>One-time admin task</h4>
                <p class="sub">Salesforce blocks browser API traffic from domains not in your CORS allowlist.</p>
              </div>
            </div>
            <ol class="cors-steps" style="list-style:none;padding:0;">
              <li class="cors-step">
                <div class="num">1</div>
                <div class="body">Open <span class="mono" style="color:var(--ink)">Setup → Quick Find → "CORS"</span>. Select <span class="mono" style="color:var(--ink)">CORS Allowlist</span>.</div>
              </li>
              <li class="cors-step">
                <div class="num">2</div>
                <div class="body">
                  Click <span class="mono" style="color:var(--ink)">New</span> and paste this origin:
                  <div class="mono-field" style="margin-top:6px;">
                    <code id="cors-origin">https://quantumshield.example</code>
                    <button type="button" id="copy-cors">Copy</button>
                  </div>
                </div>
              </li>
              <li class="cors-step">
                <div class="num">3</div>
                <div class="body">Save. Subsequent users of the scanner in this org do not need to repeat this step.</div>
              </li>
            </ol>
          </div>
        </div>
      </article>

      <article class="qs-card">
        <div class="qs-card-head"><h3>Part 4 · Paste your Consumer Key</h3></div>
        <div class="qs-card-body">
          <p class="sub" style="margin-top:0;">
            In your new External Client App, open the <span class="mono" style="color:var(--ink)">Manage Consumer Details</span> panel. Copy the <span class="mono" style="color:var(--ink)">Consumer Key</span> and paste it into
            <a href="/connect" style="color:var(--navy-600);font-weight:600;">/connect</a>. We remember it in your browser's localStorage so you never need to paste it again on this device.
          </p>
        </div>
      </article>
    </section>

    <p style="margin-top:40px;font-size:11.5px;color:var(--muted);font-family:var(--mono);">
      QuantumShield is read-only. We never modify your Salesforce configuration. Source:
      <a href="https://github.com/andelas/quantum-shield" style="color:var(--navy-600);">github.com/andelas/quantum-shield</a>.
    </p>
  </main>

  <script>
    const origin = window.location.origin;
    const cb = document.getElementById('redirect-uri');
    const co = document.getElementById('cors-origin');
    if (cb) cb.textContent = `${origin}/callback`;
    if (co) co.textContent = origin;
    document.getElementById('copy-callback')?.addEventListener('click', () => {
      if (cb?.textContent) navigator.clipboard.writeText(cb.textContent).catch(() => {});
    });
    document.getElementById('copy-cors')?.addEventListener('click', () => {
      if (co?.textContent) navigator.clipboard.writeText(co.textContent).catch(() => {});
    });
  </script>
</Shell>
