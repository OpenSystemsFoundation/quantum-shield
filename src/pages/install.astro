---
import Shell from '../layouts/Shell.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SETUP_STEPS } from '../lib/auth/setupSteps';

// Server-rendered default; the script below swaps in the origin actually
// serving the page (preview builds, localhost).
const PROD_ORIGIN = 'https://quantumshield.opensf.foundation';
---

<Shell title="Setup guide — QuantumShield">
  <SiteHeader />

  <main style="max-width:820px;margin:0 auto;padding:48px 32px 80px;">
    <div class="tiny-caps" style="color:var(--navy-600);">Setup guide</div>
    <h1 class="display" style="font-size:34px;font-weight:600;letter-spacing:-0.015em;margin:6px 0 10px;">
      Run QuantumShield locally or in the browser
    </h1>
    <p style="font-size:14.5px;color:var(--ink-3);max-width:680px;">
      Recommended path: the local <span class="mono">qshield</span> CLI. It reuses the Salesforce CLI session you already have on macOS, Windows, or Linux. Browser mode remains available if you want an in-tab workflow and are willing to create an External Client App or Connected App you own.
    </p>

    <section style="margin-top:40px;display:grid;gap:20px;">
      <article class="qs-card" id="cli">
        <div class="qs-card-head"><h3>Recommended · local qshield CLI</h3></div>
        <div class="qs-card-body">
          <p class="sub" style="margin-top:0;">
            Fastest path for real orgs. No Connected App, no callback URL, no CORS allowlist, and no QuantumShield auth infrastructure in the path.
          </p>
          <ol class="cors-steps" style="list-style:none;padding:0;">
            <li class="cors-step">
              <div class="num">1</div>
              <div class="body">
                Clone the repo and install dependencies: <span class="mono" style="color:var(--ink);overflow-wrap:anywhere;">git clone https://github.com/OpenSystemsFoundation/quantum-shield.git && cd quantum-shield && npm install</span> (Node 22.23.4 or newer).
              </div>
            </li>
            <li class="cors-step">
              <div class="num">2</div>
              <div class="body">
                Authenticate once with the Salesforce CLI: <span class="mono" style="color:var(--ink)">sf org login web --alias prod-eu</span>.
              </div>
            </li>
            <li class="cors-step">
              <div class="num">3</div>
              <div class="body">
                Run the scan: <span class="mono" style="color:var(--ink)">npm run qshield -- scan --target-org prod-eu --probe-tls --region NL,EU</span>.
              </div>
            </li>
            <li class="cors-step">
              <div class="num">4</div>
              <div class="body">
                Outputs land in <span class="mono" style="color:var(--ink)">./qshield-out/</span> as PDF, CBOM JSON, OpenVEX JSON, findings CSV, and raw report JSON.
              </div>
            </li>
          </ol>
        </div>
      </article>

      <article class="qs-card" id="browser">
        <div class="qs-card-head"><h3>Browser mode · One-time org setup</h3></div>
        <div class="qs-card-body">
          <p class="sub" style="margin-top:0;">
            Browser mode never uses a shared QuantumShield app. You create the OAuth app in your own org, keep ownership of the Consumer Key, and can revoke access at any time. Sign-in always goes through your org's My Domain (for example <span class="mono">acme.my.salesforce.com</span>): the generic login.salesforce.com and test.salesforce.com pages do not allow cross-origin sign-in.
          </p>
          {SETUP_STEPS.map((section, si) => (
            <section id={section.id === 'cors' ? 'cors' : `setup-${section.id}`} style="margin-top:18px;">
              <h4 style="margin:0 0 6px;font-size:14px;">{String.fromCharCode(65 + si)}. {section.title}</h4>
              <ol style="margin:0;padding-left:22px;font-size:13px;color:var(--ink-2);line-height:1.6;">
                {section.items.map((item) => (
                  <li style="margin:4px 0;overflow-wrap:anywhere;">
                    {item.map((seg) =>
                      typeof seg === 'string' ? (
                        seg
                      ) : 'ui' in seg ? (
                        <span class="mono" style="color:var(--ink);font-size:12px;">{seg.ui}</span>
                      ) : (
                        <span class="cors-step" style="display:block;grid-template-columns:1fr;padding:0;background:none;border:0;">
                          <span class="mono-field" style="display:flex;">
                            <code data-setup-value={seg.value}>
                              {seg.value === 'callback' ? `${PROD_ORIGIN}/callback` : PROD_ORIGIN}
                            </code>
                            <button type="button" data-copy={seg.value}>Copy</button>
                          </span>
                        </span>
                      ),
                    )}
                  </li>
                ))}
              </ol>
            </section>
          ))}
          <p style="margin-top:18px;font-size:13px;color:var(--ink-2);">
            Then open <a href="/connect" style="color:var(--navy-600);font-weight:600;">/connect</a>, enter your My Domain and paste the Consumer Key. The setup page can check the CORS settings for you before you sign in.
          </p>
        </div>
      </article>

      <article class="qs-card" id="troubleshooting">
        <div class="qs-card-head"><h3>Browser mode · If sign-in fails</h3></div>
        <div class="qs-card-body">
          <dl style="margin:0;font-size:13px;color:var(--ink-2);line-height:1.6;display:grid;gap:10px;">
            <div><dt class="mono" style="color:var(--ink);">redirect_uri_mismatch (on the Salesforce page)</dt><dd style="margin:0;">The app's Callback URL does not include this site's callback URL exactly. Add it and wait a few minutes.</dd></div>
            <div><dt class="mono" style="color:var(--ink);">invalid_client</dt><dd style="margin:0;">Untick "Require secret for Web Server Flow" in the app's OAuth settings.</dd></div>
            <div><dt class="mono" style="color:var(--ink);">invalid_client_id</dt><dd style="margin:0;">Wrong key, or the app is under 10 minutes old.</dd></div>
            <div><dt class="mono" style="color:var(--ink);">"The org blocked sign-in from this site"</dt><dd style="margin:0;">The origin is missing from the CORS Allowed Origins List, or "Enable CORS for OAuth endpoints" is off.</dd></div>
            <div><dt class="mono" style="color:var(--ink);">"user is not admin approved"</dt><dd style="margin:0;">In the app's policies, let all users self-authorize or assign the app to your profile or a permission set.</dd></div>
          </dl>
        </div>
      </article>
    </section>

    <p style="margin-top:40px;font-size:11.5px;color:var(--muted);font-family:var(--mono);">
      QuantumShield is read-only. We never modify your Salesforce configuration. Source:
      <a href="https://github.com/OpenSystemsFoundation/quantum-shield" style="color:var(--navy-600);overflow-wrap:anywhere;">github.com/OpenSystemsFoundation/quantum-shield</a>.
    </p>
  </main>

  <script>
    const origin = window.location.origin;
    document.querySelectorAll<HTMLElement>('[data-setup-value]').forEach((el) => {
      el.textContent = el.dataset.setupValue === 'callback' ? `${origin}/callback` : origin;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.dataset.copy === 'callback' ? `${origin}/callback` : origin;
        navigator.clipboard
          .writeText(text)
          .then(() => {
            btn.textContent = 'Copied';
            setTimeout(() => (btn.textContent = 'Copy'), 1500);
          })
          .catch(() => {});
      });
    });
  </script>
  <SiteFooter />
</Shell>
