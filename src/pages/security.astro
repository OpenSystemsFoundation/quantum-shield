---
import Shell from '../layouts/Shell.astro';
import BlochShield from '../components/BlochShield.svelte';
---

<Shell title="Security — QuantumShield">
  <div style="border-bottom:1px solid var(--line);background:var(--surface);">
    <div style="max-width:1200px;margin:0 auto;padding:14px 24px;display:flex;align-items:center;justify-content:space-between;">
      <a href="/" class="brand hstack" style="font-weight:600;color:var(--ink);">
        <BlochShield size={24} />
        <span>QuantumShield</span>
      </a>
      <a href="/connect" style="font-size:12.5px;color:var(--muted);">Browser setup →</a>
    </div>
  </div>

  <main style="max-width:960px;margin:0 auto;padding:48px 32px 80px;">
    <div class="tiny-caps" style="color:var(--navy-600);">Security & trust</div>
    <h1 class="serif" style="font-size:34px;font-weight:500;letter-spacing:-0.015em;margin:6px 0 10px;">
      How QuantumShield keeps your org's data yours.
    </h1>
    <p style="font-size:14.5px;color:var(--ink-3);max-width:680px;">
      QuantumShield has two execution paths. Preferred path: the local <span class="mono">qshield</span> CLI reusing the Salesforce CLI session already on your machine. Optional path: a static browser app using an External Client App or Connected App you own. In neither path does QuantumShield proxy your org data.
    </p>

    <section style="display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-top:28px;">
      <div class="qs-card qs-card-body">
        <div class="tiny-caps" style="color:var(--navy-600);">Recommended path</div>
        <h3 class="serif" style="font-size:16px;font-weight:500;margin:6px 0 6px;">Local qshield CLI</h3>
        <p style="margin:0;font-size:12.5px;color:var(--ink-3);line-height:1.5;">
          Reuses the <span class="mono">sf</span> session you already authorised on macOS, Windows, or Linux. No Connected App, no callback URL, and no CORS allowlist required.
        </p>
      </div>
      <div class="qs-card qs-card-body">
        <div class="tiny-caps" style="color:var(--navy-600);">Browser mode</div>
        <h3 class="serif" style="font-size:16px;font-weight:500;margin:6px 0 6px;">Static site, customer-owned OAuth</h3>
        <p style="margin:0;font-size:12.5px;color:var(--ink-3);line-height:1.5;">
          Cloudflare Pages serves static HTML and JS only. The browser talks directly to your Salesforce instance, and the client ID comes from an External Client App or Connected App you created in your own org.
        </p>
      </div>
      <div class="qs-card qs-card-body">
        <div class="tiny-caps" style="color:var(--navy-600);">Write access</div>
        <h3 class="serif" style="font-size:16px;font-weight:500;margin:6px 0 6px;">None, ever</h3>
        <p style="margin:0;font-size:12.5px;color:var(--ink-3);line-height:1.5;">
          QuantumShield never modifies org configuration. Browser mode requests only <span class="mono">api</span> and <span class="mono">id</span>; CLI mode reuses the permissions already granted to your local <span class="mono">sf</span> session.
        </p>
      </div>
    </section>

    <section class="qs-card" style="margin-top:24px;">
      <div class="qs-card-head"><h3>Browser OAuth scopes requested</h3></div>
      <div class="qs-card-body">
        <div style="display:grid;grid-template-columns:140px 1fr auto;gap:16px;padding:10px 0;border-bottom:1px solid var(--line-2);align-items:start;font-size:12.5px;">
          <span class="mono" style="font-weight:600;">api</span>
          <span style="color:var(--ink-3);">Access the REST, Tooling, and Metadata APIs to read configuration and metadata.</span>
          <span class="pill ok">Required</span>
        </div>
        <div style="display:grid;grid-template-columns:140px 1fr auto;gap:16px;padding:10px 0;align-items:start;font-size:12.5px;">
          <span class="mono" style="font-weight:600;">id</span>
          <span style="color:var(--ink-3);">Identify the user and org for display purposes. No profile or directory data queried.</span>
          <span class="pill ok">Required</span>
        </div>
        <p style="margin:10px 0 0;color:var(--muted);font-size:11.5px;font-family:var(--mono);">
          No refresh_token scope: the browser session lives in sessionStorage and ends when the tab closes. Sign-in uses OAuth 2.0 authorization code with PKCE.
        </p>
      </div>
    </section>

    <section class="qs-card" style="margin-top:16px;">
      <div class="qs-card-head"><h3>Content Security Policy</h3></div>
      <div class="qs-card-body">
        <p style="margin-top:0;color:var(--ink-3);font-size:12.5px;">
          The deployed site serves the following CSP as an HTTP response header on every page, via the Cloudflare Pages <span class="mono">_headers</span> file in this repository (<span class="mono">public/_headers</span>). <span class="mono">connect-src</span> limits outbound requests to this origin plus Salesforce-owned domains (<span class="mono">*.salesforce.com</span>, <span class="mono">*.force.com</span>, <span class="mono">*.my.site.com</span>) — the scanner talks to your org directly and nowhere else. Fonts and images are served from this origin only; the page cannot be framed.
        </p>
        <div class="mono-field" style="margin-top:8px;font-family:var(--mono);font-size:11px;white-space:pre;overflow:auto;">
          <code>default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';
img-src 'self' data:; font-src 'self';
connect-src 'self' https://*.salesforce.com https://*.force.com https://*.my.site.com;
worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'</code>
        </div>
        <p style="margin:10px 0 0;color:var(--muted);font-size:11.5px;font-family:var(--mono);">
          Also served: X-Content-Type-Options: nosniff · Referrer-Policy: strict-origin-when-cross-origin · Permissions-Policy: camera=(), microphone=(), geolocation=(). Local dev servers (astro dev/preview) do not apply these headers.
        </p>
      </div>
    </section>
  </main>
</Shell>
