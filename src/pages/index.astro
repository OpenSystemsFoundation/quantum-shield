---
import Shell from '../layouts/Shell.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { QSHIELD_VERSION } from '../lib/version';
import { buildSampleReport } from '../lib/demo/sample';

// The hero card shows the same sample report that /demo opens, computed at
// build time from the bundled fixtures, so its numbers cannot drift from it.
const sample = await buildSampleReport();
const sev = sample.summary.bySeverity;
const sampleCategories = sample.coverage
  .filter((c) => c.id !== 'tls-probe' && c.findingCount > 0)
  .sort((a, b) => b.findingCount - a.findingCount)
  .slice(0, 4);
const categoriesWithFindings = sample.coverage.filter((c) => c.id !== 'tls-probe' && c.findingCount > 0).length;

const repo = 'https://github.com/OpenSystemsFoundation/quantum-shield';
---

<Shell title="QuantumShield, free post-quantum readiness for Salesforce · OpenSF">
  <div class="landing">
    <SiteHeader />

    <section class="sky-wash">
      <div class="container hero">
        <div>
          <div class="eyebrow">Free &amp; open source · An OpenSF project</div>
          <h1>
            Post-quantum readiness for your <span class="accent">Salesforce</span> org.
          </h1>
          <p class="lede">
            QuantumShield scans your org's cryptographic configuration against BSI TR-02102, ENISA, NCSC-NL and the NIST PQC standards, and hands you PDF, CBOM, OpenVEX, CSV and JSON reports. Run it as a local <span class="mono">qshield</span> CLI on top of the Salesforce CLI you already use, hand it to your AI coding agent, or use it in this browser. Free for everyone, forever.
          </p>
          <div class="cta-row">
            <a class="qs-btn qs-btn-primary qs-btn-lg" href="/install#cli">CLI quickstart</a>
            <a class="qs-btn qs-btn-lg" href="/connect">Browser setup</a>
            <a class="qs-btn qs-btn-lg" href="/demo" data-testid="view-sample-report">View a sample report</a>
            <a class="qs-btn qs-btn-ghost qs-btn-lg" href={repo} rel="noopener">View source</a>
          </div>
          <div class="fineprint">
            v{QSHIELD_VERSION} · Apache 2.0 · macOS, Windows and Linux · Agent skill included · No account needed
          </div>

          <div class="trust-strip">
            <div>
              <div class="label">Price</div>
              <div class="value">Free, for everyone</div>
            </div>
            <div>
              <div class="label">Licence</div>
              <div class="value">Apache 2.0</div>
            </div>
            <div>
              <div class="label">Cloud proxy</div>
              <div class="value">None</div>
            </div>
            <div>
              <div class="label">Write access</div>
              <div class="value">None, ever</div>
            </div>
          </div>
        </div>

        <a class="hero-preview" href="/demo" aria-label="Sample report summary (demo data) — open the sample report" style="display:block;color:inherit;text-decoration:none;">
          <div class="bar">
            <span class="dot"></span><span class="dot"></span><span class="dot"></span>
            <span class="t">sample report · demo data, not a real org</span>
          </div>
          <div style="padding: 22px 24px">
            <div class="eyebrow">Sample executive summary</div>
            <div class="display" style="font-size:22px;font-weight:600;letter-spacing:-0.01em;margin-top:6px;margin-bottom:16px;">
              {sample.summary.totalFindings} findings across {categoriesWithFindings} {categoriesWithFindings === 1 ? 'category' : 'categories'}
            </div>
            <div style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;margin-bottom:18px;">
              <div class="stat">
                <div class="n" style="color:var(--crit);">{sev.critical}</div>
                <div class="tiny-caps" style="margin-top:6px">Critical</div>
              </div>
              <div class="stat">
                <div class="n" style="color:var(--high);">{sev.high}</div>
                <div class="tiny-caps" style="margin-top:6px">High</div>
              </div>
              <div class="stat">
                <div class="n" style="color:var(--warn);">{sev.medium}</div>
                <div class="tiny-caps" style="margin-top:6px">Medium</div>
              </div>
              <div class="stat">
                <div class="n" style="color:var(--adv);">{sev.low}</div>
                <div class="tiny-caps" style="margin-top:6px">Low</div>
              </div>
            </div>
            {sample.summary.earliestDeadline && (
              <>
                <div class="tiny-caps">Earliest deadline</div>
                <div class="mono" style="font-size:12px;margin-top:4px;">
                  {sample.summary.earliestDeadline}
                </div>
              </>
            )}
            <div class="tiny-caps" style="margin-top:16px;">Findings by category</div>
            <div style="margin-top:4px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 14px;font-size:12px;">
              {sampleCategories.map((c) => (
                <div style="display:flex;justify-content:space-between;gap:8px;padding:5px 0;border-bottom:1px solid var(--line-2);">
                  <span style="color:var(--muted)">{c.label}</span><span class="mono">{c.findingCount}</span>
                </div>
              ))}
            </div>
            <div style="margin-top:14px;font-size:12.5px;font-weight:600;color:var(--primary);">Open the sample report →</div>
          </div>
        </a>
      </div>
    </section>

    <section class="section section-tinted" id="agents">
      <div class="container open-grid">
        <div class="section-head" style="margin-bottom:0">
          <div class="eyebrow">Built for AI agents</div>
          <h2>Ask your agent to scan the org. It already knows how.</h2>
          <p>
            Most Salesforce developers now run an AI coding agent next to the <span class="mono">sf</span> CLI. QuantumShield ships an agent skill in the repo at <span class="mono">.agents/skills/quantumshield</span>, so agents that read skills, such as Claude Code and Codex, can run a scan and explain the findings without you writing a prompt. Any other agent can be pointed at the same file.
          </p>
          <p style="margin-top:12px;">
            The CLI is made for it: no prompts, <span class="mono">--json</span> on every command, stable exit codes, a <span class="mono">doctor</span> check, and a scan of a small org in under a minute. It uses the <span class="mono">sf</span> session your agent already has, scratch orgs included.
          </p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px;">
            <a class="qs-btn qs-btn-primary" href="/install#agents">Set up your agent</a>
            <a class="qs-btn" href={`${repo}/blob/main/.agents/skills/quantumshield/SKILL.md`} rel="noopener">Read the skill</a>
          </div>
        </div>
        <div class="open-points">
          <div class="open-point">
            <strong>You ask</strong>
            <span>"Check my scratch org for post-quantum risk and tell me what to fix first."</span>
          </div>
          <div class="open-point">
            <strong>Your agent runs</strong>
            <span class="mono" style="display:block;font-size:12.5px;overflow-wrap:anywhere;">qshield doctor --json<br />qshield scan -o my-scratch --json --fail-on high</span>
          </div>
          <div class="open-point">
            <strong>You get</strong>
            <span>The posture in one line, the top findings with the replacement for each, any category it could not check, and the PDF, CBOM and OpenVEX files on disk.</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <div class="eyebrow">How it works</div>
          <h2>Evidence you can check, from tools you control.</h2>
        </div>
        <div class="landing-features">
          <article class="tile">
            <h3>Direct-to-source rules</h3>
            <p>
              Every finding cites a primary document (BSI TR-02102, ENISA PQC, the NCSC-NL factsheet, NIST FIPS 203/204/205), not a third-party maturity framework. The rules are Markdown in the repo, revised each quarter.
            </p>
          </article>
          <article class="tile">
            <h3>CLI first, browser second</h3>
            <p>
              Use the local CLI for repeatable scans. This website is a static browser app for demos, in-tab review, and teams that prefer to own the OAuth app themselves.
            </p>
          </article>
          <article class="tile">
            <h3>Your auth, your data</h3>
            <p>
              The CLI reuses the <span class="mono">sf</span> session already on your machine. Browser mode uses an External Client App or Connected App you create in your own org. Nothing is proxied and nothing is stored on our side.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section section-tinted">
      <div class="container open-grid">
        <div class="section-head" style="margin-bottom:0">
          <div class="eyebrow">Open Systems. For All.</div>
          <h2>Free for everyone. Built in the open.</h2>
          <p>
            QuantumShield is an <a href="https://opensf.foundation" rel="noopener">Open Systems Foundation</a> project. Every organisation running Salesforce has to get through the post-quantum migration, so the scanner, the rule catalog and the reports are free to use, study, change and share.
          </p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px;">
            <a class="qs-btn qs-btn-primary" href={repo} rel="noopener">Star or fork on GitHub</a>
            <a class="qs-btn" href={`${repo}/issues`} rel="noopener">Suggest a rule</a>
          </div>
        </div>
        <div class="open-points">
          <div class="open-point">
            <strong>Apache 2.0, all of it</strong>
            <span>Scanner, CLI, browser app, rules and report generators. Use it at work, ship it inside your own tooling, no strings.</span>
          </div>
          <div class="open-point">
            <strong>No accounts, no paid tier</strong>
            <span>There is nothing to sign up for and nothing to upgrade to. Every feature is in the free version because there is only the free version.</span>
          </div>
          <div class="open-point">
            <strong>Rules anyone can review</strong>
            <span>Each rule cites its source and lives as a readable document. Spot a gap or a new regulation? Open an issue or a pull request.</span>
          </div>
        </div>
      </div>
    </section>

    <SiteFooter />
  </div>
</Shell>
