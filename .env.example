# Customers bring their own Consumer Key — do NOT set a shared one here.
# PUBLIC_SF_CLIENT_ID stays empty in production; customers paste theirs via /connect.
PUBLIC_SF_CLIENT_ID=

# API version (defaults to 66.0 if unset)
PUBLIC_SF_API_VERSION=66.0

# Enable the dev-mock "Skip OAuth" shortcut on /connect. Only for local development.
# Never enable in production.
PUBLIC_DEV_MOCK=0

# Optional — fallback origin for redirect_uri when no browser origin exists (build/tests).
# In the browser the callback always uses the origin serving the page, so preview builds work.
# Production sets this to https://quantumshield.opensf.foundation (Cloudflare build variable).
# PUBLIC_APP_ORIGIN=https://quantumshield.opensf.foundation
